{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-signal-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 */12 * * *"]
  },
  "containers": [
    {
      // Stable Cloudflare resource identity; cadence is controlled by triggers.crons.
      "name": "open-signal-hourly-batch",
      "class_name": "OpenSignalBatch",
      "image": "../../apps/worker/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1,
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPEN_SIGNAL_BATCH",
        "class_name": "OpenSignalBatch"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenSignalBatch"]
    }
  ],
  "secrets": {
    "required": [
      "OPEN_SIGNAL_DATABASE_URL",
      "DEEPSEEK_API_KEY",
      "OPEN_SIGNAL_R2_ENDPOINT_URL",
      "OPEN_SIGNAL_R2_ACCESS_KEY_ID",
      "OPEN_SIGNAL_R2_SECRET_ACCESS_KEY",
      "OPEN_SIGNAL_R2_PUBLIC_BUCKET",
      "OPEN_SIGNAL_REVALIDATE_URL",
      "OPEN_SIGNAL_REVALIDATE_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
