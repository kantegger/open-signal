{
  "name": "@open-signal/cloudflare-scheduler",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "cf:types:check": "wrangler types worker-configuration.d.ts --include-runtime false --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run cf:types:check && npm run typecheck",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "typescript": "^5.9.3",
    "wrangler": "4.120.0"
  }
}
